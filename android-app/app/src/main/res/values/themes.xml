<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhisperBridge.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_neutral</item>
        <item name="colorPrimaryContainer">@color/green_soft</item>
        <item name="colorOnPrimaryContainer">@color/green_text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:navigationBarColor">@color/card_bg</item>
    </style>

    <style name="Theme.WhisperBridge" parent="Theme.WhisperBridge.Base" />

    <!-- komodos corner shapes -->
    <style name="ShapeKomodosPill">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeKomodosMed">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeKomodosCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Shared action buttons — Material Expressive: generous radii,
         emphasized 14sp labels, pill vs rounded-square shape contrast. -->

    <!-- Icon-over-text pill button (compose row). -->
  <style name="WB.IconTopButton" parent="Widget.Material3.Button">
    <item name="android:gravity">center</item>
    <item name="android:textAlignment">center</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">none</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:paddingStart">8dp</item>
    <item name="android:paddingEnd">8dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="iconGravity">textTop</item>
    <item name="iconSize">20dp</item>
    <item name="iconPadding">5dp</item>
    <item name="cornerRadius">32dp</item>
  </style>

  <!-- Text-only tonal action button (mouse row). Filled, no outline. -->
  <style name="WB.TextButton" parent="Widget.Material3.Button">
    <item name="android:gravity">center</item>
    <item name="android:textAlignment">center</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">none</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:paddingStart">6dp</item>
    <item name="android:paddingEnd">6dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">2dp</item>
    <item name="cornerRadius">18dp</item>
    <item name="backgroundTint">@color/chip_bg</item>
  </style>

  <!-- Icon-over-text tonal button (scroll/arrows). Filled, no outline. -->
  <style name="WB.IconTopOutlined" parent="Widget.Material3.Button">
    <item name="android:gravity">center</item>
    <item name="android:textAlignment">center</item>
    <item name="android:textSize">13sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:maxLines">1</item>
    <item name="android:ellipsize">none</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:paddingStart">6dp</item>
    <item name="android:paddingEnd">6dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="iconGravity">textTop</item>
    <item name="iconSize">20dp</item>
    <item name="iconPadding">5dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">2dp</item>
    <item name="cornerRadius">18dp</item>
    <item name="backgroundTint">@color/chip_bg</item>
  </style>

    <!-- Icon-left filled pill button (share sheet). -->
    <style name="WB.IconStartButton" parent="Widget.Material3.Button">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Icon-left tonal pill button (share sheet). Filled, no outline. -->
    <style name="WB.IconStartOutlined" parent="Widget.Material3.Button">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/chip_bg</item>
    </style>

    <!-- Icon-left text button (share sheet dismiss). -->
    <style name="WB.IconStartText" parent="Widget.Material3.Button.TextButton">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>
