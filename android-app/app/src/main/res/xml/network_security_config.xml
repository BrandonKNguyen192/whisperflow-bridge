<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The bridge speaks plain HTTP to a user-supplied LAN or tailnet address.
         Confidentiality comes from Tailscale's WireGuard tunnel, not from TLS.
         On a plain LAN the token and every dictated character travel in the clear. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
