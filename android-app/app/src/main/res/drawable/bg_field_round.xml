<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted input field: translucent fill + glass border, accent focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/glass_input" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/glass_input" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
